<div
  class="wave-divider color-{{ section.settings.color_scheme }}"
  style="--wave-height: {{ section.settings.height }}px; --wave-height-mobile: {{ section.settings.mobile_height }}px;"
>
  {%- if section.settings.flip_vertical -%}
    {%- render 'wave', shape: 'above' -%}
  {%- else -%}
    {%- render 'wave', shape: 'below' -%}
  {%- endif -%}
</div>

{%- style -%}
  .wave-divider {
    display: block;
    line-height: 0;
    background: transparent;
  }

  {%- if section.settings.overlap_previous_section or section.settings.overlap_next_section %}
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 2;
      {%- if section.settings.overlap_previous_section %}
        margin-top: -{{ section.settings.height }}px;
      {%- endif %}
      {%- if section.settings.overlap_next_section %}
        margin-bottom: -{{ section.settings.height }}px;
      {%- endif %}
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        {%- if section.settings.overlap_previous_section %}
          margin-top: -{{ section.settings.mobile_height }}px;
        {%- endif %}
        {%- if section.settings.overlap_next_section %}
          margin-bottom: -{{ section.settings.mobile_height }}px;
        {%- endif %}
      }
    }
  {%- endif %}
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.wave-divider.name",
  "tag": "section",
  "class": "section section--wave-divider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-8"
    },
    {
      "type": "range",
      "id": "height",
      "min": 20,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 60,
      "label": "t:sections.wave-divider.settings.height.label"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 10,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30,
      "label": "t:sections.wave-divider.settings.mobile_height.label"
    },
    {
      "type": "checkbox",
      "id": "flip_vertical",
      "default": false,
      "label": "t:sections.wave-divider.settings.flip_vertical.label",
      "info": "t:sections.wave-divider.settings.flip_vertical.info"
    },
    {
      "type": "checkbox",
      "id": "overlap_previous_section",
      "default": false,
      "label": "t:sections.wave-divider.settings.overlap_previous_section.label",
      "info": "t:sections.wave-divider.settings.overlap_previous_section.info"
    },
    {
      "type": "checkbox",
      "id": "overlap_next_section",
      "default": false,
      "label": "t:sections.wave-divider.settings.overlap_next_section.label",
      "info": "t:sections.wave-divider.settings.overlap_next_section.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.wave-divider.presets.name"
    }
  ]
}
{% endschema %}
